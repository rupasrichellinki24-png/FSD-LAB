scard_timeout_after_message_end_visibility_seconds\":3.5,\"ask_chatgpt_system_message\":\"The user is referring to an ad shown to them about: {LABEL}. Your response MUST BE ABOUT THE ADS shown, since the user explicitly asked about them. They are using the 'Ask ChatGPT' feature and you must reply to the user query using the information about the ads, which is:\\n{DATA}\\n\\nFor example: if the user asks 'Tell me more about these' (or other wordings), then your answer should be about details or further information on products, services, locations etc described in the ad and the links in the ad.\",\"android_large_font_scale_threshold\":1.5,\"onboarding\":{\"screen_transparency_image_url\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/controls_en.png\",\"impression_count\":5,\"card_image_url\":\"https://cdn.openai.com/chatgpt/clients/onboarding/onboarding-example-1.png\",\"screen_privacy_image_url\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/secure.png\",\"screen_personalization_image_url\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/personalization_en.png\",\"screen_trust_image_url\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/trusted_en.png\",\"screen_transparency_image_url_when_personalization_unavailable\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/personalization_unavailable_transparency_v1.jpg\",\"screen_trust_image_url_when_personalization_unavailable\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/personalization_unavailable_trust_v1.jpg\"},\"android_display_zoom_scale_threshold\":1,\"late_ads_event_discard_timeout_seconds\":5},\"is_device_based\":false,\"passed\":true},\"216490582\":{\"name\":\"216490582\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"url\":\"https://help.openai.com/articles/20001509\"},\"is_device_based\":false,\"passed\":false},\"3067422349\":{\"name\":\"3067422349\",\"rule_id\":\"default\",\"secondar